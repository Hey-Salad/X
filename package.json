{
  "name": "heysalad-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server exposing HeySalad operational data and tools",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "heysaladx": "agents/heysaladx/bin/heysaladx.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node src/server.js",
    "demo:check": "node scripts/demo-connectivity.js",
    "check:sse": "node scripts/check-sse.mjs",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "heysaladx": "node agents/heysaladx/bin/heysaladx.js",
    "deepseek:agent": "node agents/deepseek_api_agent.js",
    "pm2:reload:deepseek": "pm2 reload heysalad-deepseek-coder"
  },
  "keywords": [
    "mcp",
    "heysalad",
    "cloudflare"
  ],
  "author": "HeySalad",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "@sendgrid/mail": "^8.1.6",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "cli-spinners": "^2.9.0",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "inquirer": "^9.2.12",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "openai": "^4.77.2",
    "picocolors": "^1.0.0",
    "qrcode": "^1.5.4",
    "word-wrap": "^1.2.5",
    "zod": "^3.25.76"
  }
}
